generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  هزینه
  درامد
}

enum Category {
  حقوق
  تعمیرات
  تجهیزات
  شهریه
  مصرفی
  ملزومات
  سایر
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         String        @default("user")
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType
  amount      Int // به تومان/ریال، همیشه عدد صحیح ذخیره کن
  title       String
  description String?
  category    Category
  date        DateTime // تاریخ واقعیِ رخداد تراکنش
  invoiceUrl  String? // آدرس عکس فاکتور آپلود شده
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  userId      String
  user        User            @relation(fields: [userId], references: [id])

  @@index([date])
  @@index([type])
}
